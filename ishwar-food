        function estimateDistanceKm(address) {
            let pincodeMatch = address.match(/\d{6}/);
            if(pincodeMatch) {
                let code = parseInt(pincodeMatch[0]);
                if(code === 848127) return "1.2 km (5 mins)";
                if(code === 848101) return "3.5 km (12 mins)";
                if(code === 848102) return "5.8 km (18 mins)";
                if(code === 848134) return "8.1 km (22 mins)";
            }
            return "4.2 km (15 mins)";
        }

        function trackOrderLookup() {
            const inputVal = document.getElementById('trackOrderIdInput').value.trim().toUpperCase();
            const resultBox = document.getElementById('trackingResultBox');
            const errorBox = document.getElementById('trackingErrorBox');

            if (!inputVal) { alert("Please enter an Order ID!"); return; }

            const matchedOrder = liveCustomerOrders.find(o => o.id.toUpperCase() === inputVal);

            if (matchedOrder) {
                errorBox.style.display = 'none';
                resultBox.style.display = 'block';

                document.getElementById('displayTrackId').innerText = matchedOrder.id;
                document.getElementById('displayTrackCustDetails').innerText = `Customer: ${matchedOrder.name} | Total: ₹${matchedOrder.total}`;

                const distText = estimateDistanceKm(matchedOrder.address);
                document.getElementById('calculatedDistanceText').innerText = distText;

                const encodedOrigin = encodeURIComponent(RESTAURANT_ADDRESS);
                const encodedDestination = encodeURIComponent(`${matchedOrder.address}, Bihar`);
                document.getElementById('googleMapIframe').src = `https://maps.google.com/maps?saddr=${encodedOrigin}&daddr=${encodedDestination}&output=embed`;

                startDeliveryReverseCountdown();

                const currentStatus = matchedOrder.status;
                document.querySelectorAll('.tracker-step').forEach(step => step.classList.remove('active'));

                const stepReceived = document.getElementById('step-Received');
                const stepPreparing = document.getElementById('step-Preparing');
                const stepOut = document.getElementById('step-Out');
                const stepDelivered = document.getElementById('step-Delivered');
                const statusBanner = document.getElementById('statusBannerText');

                stepReceived.classList.add('active'); 

                if(currentStatus === 'Received' || currentStatus === 'Accepted') {
                    statusBanner.innerText = "Order Received & Accepted by Ishwar Food Kitchen!";
                } else if(currentStatus === 'Preparing') {
                    stepPreparing.classList.add('active');
                    statusBanner.innerText = "Chef is currently PREPARING your meal hot & fresh!";
                } else if(currentStatus === 'Out for Delivery') {
                    stepPreparing.classList.add('active'); stepOut.classList.add('active');
                    statusBanner.innerText = "Delivery partner is heading to your location in Samastipur!";
                } else if(currentStatus === 'Delivered') {
                    stepPreparing.classList.add('active'); stepOut.classList.add('active'); stepDelivered.classList.add('active');
                    statusBanner.innerText = "Order Successfully Delivered! Enjoy your meal! ❤️";
                } else if(currentStatus === 'Rejected') {
                    statusBanner.innerText = "Order Status: Rejected by Restaurant. Please contact support.";
                }
            } else {
                resultBox.style.display = 'none';
                errorBox.style.display = 'block';
            }
        }

