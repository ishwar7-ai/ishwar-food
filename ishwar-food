        function closeOrderModal() {
            document.getElementById('orderSuccessModal').style.display = 'none';
            cart = []; saveCartToStorage(); updateCartUI(); refreshCardButtons();
            if(lastPlacedOrderId) {
                document.getElementById('trackOrderIdInput').value = lastPlacedOrderId;
                trackOrderLookup(); switchPage('track');
            } else switchPage('home');
        }

        function triggerConfetti() {
            if (typeof confetti === 'function') confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
        }

        function placeOrderAllChannels() {
            if (cart.length === 0) { alert("Please add items to cart!"); return; }

            const now = new Date();
            const hour = now.getHours();
            if (hour < 10 || hour >= 23) {
                if(!confirm("⚠️ Kitchen is currently CLOSED (Operating hours: 10:00 AM to 11:00 PM). Do you still want to place this advance pre-order?")) return;
            }

            const name = document.getElementById('custName').value.trim();
            const phone = activeCustomerPhone || document.getElementById('custPhone').value.trim();
            const pincode = document.getElementById('custPincode').value.trim();
            const house = document.getElementById('custHouse').value.trim();
            const area = document.getElementById('custArea').value.trim();
            const landmark = document.getElementById('custLandmark').value.trim();
            const instructions = document.getElementById('custInstructions').value.trim();
            const payment = document.querySelector('input[name="paymentMethod"]:checked').value;

            if (!pincode || !/^[0-9]{6}$/.test(pincode)) { alert("Enter valid 6-digit PIN Code!"); return; }
            if (!phone || !/^[0-9]{10}$/.test(phone)) { alert("Enter valid 10-digit Mobile Number!"); return; }
            if (!name || !house || !area) { alert("Complete all required fields!"); return; }

            const newOrderId = generateOrderId(); lastPlacedOrderId = newOrderId;
            let itemsList = ""; let subtotal = 0;

            cart.forEach((item, index) => {
                const itemTotal = item.price * item.qty; subtotal += itemTotal;
                itemsList += `${index + 1}. ${item.name} x ${item.qty} = ₹${itemTotal}\n`;
            });

            let deliveryFee = subtotal >= 199 ? 0 : 30;
            let tax = Math.round((subtotal - appliedDiscount) * 0.05);
            let grandTotal = (subtotal - appliedDiscount) + deliveryFee + 15 + tax;

            liveCustomerOrders.unshift({
                id: newOrderId,
                name, phone,
                address: `${house}, ${area}, PIN: ${pincode}`,
                items: itemsList.replace(/\n/g, ', '),
                total: grandTotal,
                status: 'Received',
                date: new Date().toLocaleDateString('en-IN')
            });

            saveOrdersToStorage();
            playAdminOrderAlertSound();

            if(isAdminLoggedIn) renderAdminOrdersList();

            let fullMsg = `--- NEW ORDER: ISHWAR FOOD ---\n🆔 *Order ID:* ${newOrderId}\n👤 *Customer:* ${name}\n📞 *Phone:* ${phone}\n📍 *Address:* ${house}, ${area}, PIN: ${pincode}\n`;
            if (instructions) fullMsg += `📝 *Instructions:* ${instructions}\n`;
            fullMsg += `💳 *Payment:* ${payment}\n\n*Ordered Items:*\n${itemsList}\nGrand Total: ₹${grandTotal}`;

            document.getElementById('modalOrderIdDisplay').innerText = newOrderId;
            document.getElementById('orderSuccessModal').style.display = 'flex';
            triggerConfetti();

            window.open(`https://wa.me/91${ADMIN_PHONE}?text=${encodeURIComponent(fullMsg)}`, '_blank');
            setTimeout(() => { window.open(`mailto:${ADMIN_EMAIL}?subject=${encodeURIComponent("New Order " + newOrderId)}&body=${encodeURIComponent(fullMsg)}`, '_blank'); }, 1000);
