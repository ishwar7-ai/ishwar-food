        function confirmCustomizationAndAdd() {
            if(!pendingCustomizeItem) return;
            playAudioFeedback();

            let extraCost = 0;
            if(document.getElementById('addCheeseCheck').checked) extraCost += 30;
            if(document.getElementById('addButterCheck').checked) extraCost += 20;

            const spice = document.getElementById('spiceLevelSelect').value;
            const finalPrice = pendingCustomizeItem.price + extraCost;

            const exist = cart.find(i => i.id === pendingCustomizeItem.id);
            if (exist) exist.qty += 1;
            else cart.push({ ...pendingCustomizeItem, price: finalPrice, name: `${pendingCustomizeItem.name} (${spice})`, qty: 1 });

            saveCartToStorage();
            document.getElementById('customizationModal').style.display = 'none';
            document.getElementById('addCheeseCheck').checked = false;
            document.getElementById('addButterCheck').checked = false;

            updateCartUI(); refreshCardButtons();
        }

        function toggleVegFilter() {
            isPureVegOnly = !isPureVegOnly;
            document.getElementById('vegFilterToggle').checked = isPureVegOnly;
            document.getElementById('vegFilterToggleMenu').checked = isPureVegOnly;

            const wrapHome = document.getElementById('vegWrapperHome');
            const wrapMenu = document.getElementById('vegWrapperMenu');

            if (isPureVegOnly) {
                wrapHome.classList.add('active-veg-mode'); wrapMenu.classList.add('active-veg-mode');
            } else {
                wrapHome.classList.remove('active-veg-mode'); wrapMenu.classList.remove('active-veg-mode');
            }
            refreshCardButtons();
        }

        function loadInitialMenu() {
            checkCustomerAuthGate();
            renderFeaturedGrid(); renderFilteredGrid(); updateCartUI(); renderPublicOffers();
        }

        function renderFeaturedGrid() {
            let items = menuItems;
            if (isPureVegOnly) items = items.filter(i => i.isVeg);
            document.getElementById('featuredFoodGrid').innerHTML = items.slice(0, 4).map(createFoodCardHTML).join('');
        }

        function filterMenu(category, btnElement) {
            currentCategory = category;
            document.querySelectorAll('.cat-btn').forEach(btn => btn.classList.remove('active'));
            if(btnElement) btnElement.classList.add('active');
            else {
                const targetBtn = document.getElementById(`btn-cat-${category}`);
                if (targetBtn) targetBtn.classList.add('active');
            }

            const heading = document.getElementById('menuCategoryHeading');
            const sub = document.getElementById('menuCategorySub');

            if (category === 'dessert') {
                heading.innerText = "Desserts & Drinks"; sub.innerText = "Sweet treats, refreshing lassis & cold beverages";
            } else if (category === 'main') {
                heading.innerText = "Main Course Dishes"; sub.innerText = "Rich gravies, aromatic biryanis & special thalis";
            } else if (category === 'starters') {
                heading.innerText = "Starters & Chinese"; sub.innerText = "Crispy rolls, wok-tossed noodles & grilled tikka";
            } else if (category === 'breads') {
                heading.innerText = "Breads & Naan"; sub.innerText = "Fresh clay-baked tandoori rotis, naans & parathas";
            } else {
                heading.innerText = "Our Full Menu"; sub.innerText = "Choose your favorite meal from our complete catalog";
            }
            switchPage('menu'); renderFilteredGrid();
        }

        function renderFilteredGrid() {
            let filtered = menuItems;
            if (currentCategory !== 'all') filtered = filtered.filter(item => item.cat === currentCategory);
            if (isPureVegOnly) filtered = filtered.filter(item => item.isVeg);

            const grid = document.getElementById('fullMenuGrid');
            if (filtered.length === 0) grid.innerHTML = `<p style="color: var(--text-muted); grid-column: 1/-1; padding: 20px; text-align: center;">No dishes found matching your selection.</p>`;
            else grid.innerHTML = filtered.map(createFoodCardHTML).join('');
        }

        function handleSearch() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            switchPage('menu');
            let filtered = menuItems.filter(item => 
                item.name.toLowerCase().includes(query) || 
                item.desc.toLowerCase().includes(query) ||
                item.cat.toLowerCase().includes(query)
            );
            if (isPureVegOnly) filtered = filtered.filter(i => i.isVeg);
            
            const grid = document.getElementById('fullMenuGrid');
            if (filtered.length === 0) grid.innerHTML = `<p style="color: var(--text-muted); grid-column: 1/-1; padding: 20px; text-align: center;">No dishes found for "${query}".</p>`;
            else grid.innerHTML = filtered.map(createFoodCardHTML).join('');
        }

        function updateQuantity(itemId, change) {
            playAudioFeedback();
            const item = menuItems.find(i => i.id === itemId);
            if (!item || !item.isAvailable) return;

            const cartItem = cart.find(i => i.id === itemId);
            if (cartItem) {
                cartItem.qty += change;
                if (cartItem.qty <= 0) cart = cart.filter(i => i.id !== itemId);
            }
            saveCartToStorage(); updateCartUI(); refreshCardButtons();
        }

        function refreshCardButtons() { renderFeaturedGrid(); renderFilteredGrid(); }

        function applyCoupon() {
            const code = document.getElementById('couponCodeInput').value.trim().toUpperCase();
            const msgBox = document.getElementById('couponMsg');
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            if (subtotal === 0) {
                msgBox.style.display = 'block'; msgBox.style.color = '#ff385c'; msgBox.innerText = 'Cart is empty!'; return;
            }

            if (activeCoupons[code]) {
                const coupon = activeCoupons[code];
                if (subtotal < coupon.minOrder) {
                    msgBox.style.display = 'block'; msgBox.style.color = '#ff385c';
                    msgBox.innerText = `Min order of ₹${coupon.minOrder} required!`;
                    appliedDiscount = 0; appliedCouponCode = "";
                } else {
                    msgBox.style.display = 'block'; msgBox.style.color = '#28a745';
                    msgBox.innerText = `Coupon '${code}' applied!`;
                    appliedCouponCode = code;
                    if (coupon.type === "percent") appliedDiscount = Math.round((subtotal * coupon.value) / 100);
                    else if (coupon.type === "flat") appliedDiscount = coupon.value;
                    else if (coupon.type === "freedel") appliedDiscount = subtotal < 199 ? 30 : 0;
                }
            } else {
                msgBox.style.display = 'block'; msgBox.style.color = '#ff385c';
                msgBox.innerText = 'Invalid Coupon Code!';
                appliedDiscount = 0; appliedCouponCode = "";
            }
            updateCartUI();
        }

        function togglePaymentView(mode) {
            const upiBox = document.getElementById('upiDetailsBox');
            const cardBox = document.getElementById('cardDetailsBox');
            if (mode === 'upi') { upiBox.style.display = 'block'; cardBox.style.display = 'none'; generateDynamicQR(); }
            else if (mode === 'card') { upiBox.style.display = 'none'; cardBox.style.display = 'block'; }
            else { upiBox.style.display = 'none'; cardBox.style.display = 'none'; }
        }

        function generateDynamicQR() {
            if (currentGrandTotal <= 0) return;
            const upiData = `upi://pay?pa=${ADMIN_UPI_ID}&pn=IshwarFood&am=${currentGrandTotal}&cu=INR&tn=FoodOrderPayment`;
            document.getElementById('dynamicQrImage').src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(upiData)}`;

            document.getElementById('directPhonePeBtn').href = `phonepe://pay?pa=${ADMIN_UPI_ID}&pn=IshwarFood&am=${currentGrandTotal}&cu=INR&tn=FoodOrder`;
            document.getElementById('directGPayBtn').href = `tez://upi/pay?pa=${ADMIN_UPI_ID}&pn=IshwarFood&am=${currentGrandTotal}&cu=INR&tn=FoodOrder`;
            document.getElementById('directPaytmBtn').href = `paytmmp://pay?pa=${ADMIN_UPI_ID}&pn=IshwarFood&am=${currentGrandTotal}&cu=INR&tn=FoodOrder`;
        }

        function generateOrderId() { return `#ISH-${Math.floor(100000 + Math.random() * 900000)}`; }

        function updateCartUI() {
            const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById('cartBadgeCount').innerText = totalCount;
            const cartList = document.getElementById('cartListItems');
            const floatBar = document.getElementById('floatingCartBar');
            const crossSellBox = document.getElementById('crossSellBox');

            if (cart.length > 0) {
                floatBar.style.display = 'flex';
                document.getElementById('floatCartQty').innerText = `${totalCount} ${totalCount === 1 ? 'Item' : 'Items'}`;
                document.getElementById('floatCartTotal').innerText = currentGrandTotal;
                if(crossSellBox) crossSellBox.style.display = 'block';
            } else {
                floatBar.style.display = 'none';
                if(crossSellBox) crossSellBox.style.display = 'none';
            }

            if (cart.length === 0) {
                cartList.innerHTML = `<p style="color:var(--text-muted); text-align:center; padding:20px;">Your cart is empty.</p>`;
                document.getElementById('billSubtotal').innerText = '0';
                document.getElementById('billTax').innerText = '0';
                document.getElementById('cartTotalPrice').innerText = '0';
                document.getElementById('discountRow').style.display = 'none';
                appliedDiscount = 0; currentGrandTotal = 0; return;
            }

            let html = ''; let subtotal = 0;
            cart.forEach(item => {
                const itemTotal = item.price * item.qty;
                subtotal += itemTotal;
                html += `
                    <div class="cart-item">
                        <div>
                            <div style="font-weight:600;">${item.name}</div>
                            <small style="color:var(--text-muted);">₹${item.price} x ${item.qty}</small>
                        </div>
                        <div class="qty-controls">
                            <button class="qty-btn" onclick="updateQuantity(${item.id}, -1)">-</button>
                            <span>${item.qty}</span>
                            <button class="qty-btn" onclick="updateQuantity(${item.id}, 1)">+</button>
                        </div>
                        <div style="font-weight:bold; color:var(--accent);">₹${itemTotal}</div>
                    </div>
                `;
            });

            cartList.innerHTML = html;
            let deliveryFee = subtotal >= 199 ? 0 : 30;
            document.getElementById('billDeliveryFee').innerText = deliveryFee === 0 ? 'FREE' : '₹30';

            const tax = Math.round((subtotal - appliedDiscount) * 0.05);
            currentGrandTotal = (subtotal - appliedDiscount) + deliveryFee + 15 + tax;
            if (currentGrandTotal < 0) currentGrandTotal = 0;

            document.getElementById('billSubtotal').innerText = subtotal;
            document.getElementById('billTax').innerText = tax;
            document.getElementById('cartTotalPrice').innerText = currentGrandTotal;

            if (appliedDiscount > 0) {
                document.getElementById('discountRow').style.display = 'flex';
                document.getElementById('billDiscount').innerText = appliedDiscount;
            } else document.getElementById('discountRow').style.display = 'none';

            if (document.getElementById('upiDetailsBox').style.display === 'block') generateDynamicQR();
        }

