            if (!rawUrl) return "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?q=80&w=400";
            rawUrl = rawUrl.trim();
            try {
                if (rawUrl.includes("google.com/imgres") || rawUrl.includes("google.com/url")) {
                    const urlObj = new URL(rawUrl);
                    const imgUrlParam = urlObj.searchParams.get("imgurl") || urlObj.searchParams.get("url");
                    if (imgUrlParam) return decodeURIComponent(imgUrlParam);
                }
            } catch(e) {}
            return rawUrl;
        }

