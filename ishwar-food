        function fetchCurrentGPSLocation() {
            if ("geolocation" in navigator) {
                const btn = document.querySelector('.gps-location-btn');
                btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Detecting GPS Location...`;
                
                navigator.geolocation.getCurrentPosition(
                    async (position) => {
                        const lat = position.coords.latitude;
                        const lng = position.coords.longitude;
                        try {
                            const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`);
                            const data = await response.json();
                            if (data && data.address) {
                                const house = data.address.building || data.address.house_number || data.address.road || "GPS Location";
                                const area = data.address.suburb || data.address.village || data.address.city || "Samastipur";
                                const postcode = data.address.postcode || "848101";

                                document.getElementById('custHouse').value = house;
                                document.getElementById('custArea').value = area;
                                document.getElementById('custPincode').value = postcode.replace(/[^0-9]/g, '').slice(0, 6);
                                alert("✅ Current Location & PIN Code fetched successfully!");
                            }
                        } catch (err) {
                            document.getElementById('custHouse').value = `GPS Lat: ${lat.toFixed(4)}, Lng: ${lng.toFixed(4)}`;
                            document.getElementById('custArea').value = "Samastipur";
                        }
                        btn.innerHTML = `<i class="fa-solid fa-location-crosshairs"></i> Use Current GPS Location`;
                    },
                    (error) => {
                        alert("⚠️ Location Permission Denied. Enter address manually.");
                        btn.innerHTML = `<i class="fa-solid fa-location-crosshairs"></i> Use Current GPS Location`;
                    },
                    { enableHighAccuracy: true, timeout: 10000 }
                );
            }
        }

